{
  "name": "makerspace",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx server/dist/server.js",
    "start:client": "cd client/ && npm run start",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server/ && tsc  --build --clean && tsc -p .",
    "build:client": "cd client/ && npm install --force && npm run build",
    "start:dev": "cross-env NODE_ENV=development npm run build:dev",
    "start:staging": "cross-env NODE_ENV=staging npm run build:dev",
    "start:debug": "cross-env NODE_ENV=development npm run build:server && nodemon --exec tsx --inspect=0.0.0.0:9229 server/dist/server.js",
    "build:dev": "nodemon server/src/server.ts --exec tsx server/src/server.ts -e ts,graphql",
    "knex:migrate:make": "knex --migrations-directory server/src/db/migrations migrate:make -x ts",
    "knex:migrate:latest": "knex --knexfile server/dist/db/knexFile.js migrate:latest",
    "knex:migrate:rollback": "knex --knexfile server/dist/db/knexFile.js migrate:rollback",
    "knex:migrate:unlock": "knex --knexfile server/dist/db/knexFile.js migrate:unlock",
    "lint": "cd server/ && eslint -c eslint.config.js src/**/*.ts",
    "lint-fix": "cd server/ && eslint -c eslint.config.js --fix src/**/*.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.864.0",
    "@graphql-tools/schema": "^8.2.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@slack/web-api": "^7.7.0",
    "@types/express-ws": "^3.0.5",
    "@types/ws": "^8.18.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.17.2",
    "express-ws": "^5.0.2",
    "express-xml-bodyparser": "^0.4.1",
    "form-data": "^4.0.4",
    "graphql": "^16.6.0",
    "graphql-scalars": "^1.13.6",
    "graphql-tag": "^2.12.6",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "knex": "^3.1.0",
    "mailgun.js": "^12.0.3",
    "makerspace": "file:",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "node-schedule": "^2.1.1",
    "npm": "^10.8.2",
    "passport": "~0.6.0",
    "passport-local": "^1.0.0",
    "pg": "^8.7.1",
    "side-channel-list": "^1.0.0",
    "side-channel-map": "^1.0.1",
    "side-channel-weakmap": "^1.0.2",
    "typescript": "^4.4.3",
    "tsx": "^4.16.5",
    "uuid": "^8.3.2",
    "ws": "^8.18.3",
    "xml2js": "^0.6.2"
  },
  "description": "",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.24.7",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.4",
    "@testing-library/user-event": "^13.5.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.17.4",
    "@types/express-xml-bodyparser": "^0.3.5",
    "@types/got": "^9.6.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.1.0",
    "@types/node-schedule": "^2.1.7",
    "@types/passport": "^1.0.11",
    "@types/passport-local": "^1.0.35",
    "@types/react": "^18.0.31",
    "@types/react-dom": "^18.0.11",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.26",
    "@types/uuid": "^8.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.35.0",
    "node": "^22.6.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=20.x"
  }
}
